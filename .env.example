# Copy to .env and fill in real credentials locally. Never commit .env.
# Required for EDGAR (your name and email) and FRED
SEC_USER_AGENT=
FRED_API_KEY=

# Evaluation only
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Alert delivery
SLACK_WEBHOOK_URL=

# Configure providers used by LLM_CHAIN; credentials remain blank here.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODE=live
LLM_CHAIN=snowflake,gemini,ollama

# Local API and Streamlit client
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_TOKEN=

# Optional Kalshi authentication; public market data needs no key
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
